NODE_ENV=production
PORT=3001

DATABASE_URL=postgresql://memoryostm:<DB_PASSWORD>@<DB_HOST>:25060/memoryostm?sslmode=require
MEMORY_STORE_BACKEND=postgres
MEMORY_STORE_PROVIDER=local
PRISMA_DB_PUSH_ON_START=true

JWT_SECRET=<LONG_RANDOM_SECRET_MIN_16_CHARS>
MEMORYOS_JWT_SECRET=<SAME_AS_JWT_SECRET>
JWT_ISSUER=memoryos
JWT_AUDIENCE=memoryos-api

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

POLAR_CHECKOUT_URL_PRO=placeholder_pro
POLAR_CHECKOUT_URL_SCALE=placeholder_scale
POLAR_CHECKOUT_URL_ENTERPRISE=
CHECKOUT_PROVIDER=polar


OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://memoryostm.live
OPENROUTER_APP_TITLE=MemoryOS Living Memory Demo

AGENT_A_MODEL=z-ai/glm-4.5-air:free
AGENT_B_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
NOTION_CLIENT_ID=<NOTION_CLIENT_ID>
NOTION_CLIENT_SECRET=<NOTION_CLIENT_SECRET>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
SLACK_CLIENT_ID=<SLACK_CLIENT_ID>
SLACK_CLIENT_SECRET=<SLACK_CLIENT_SECRET>
CONNECTOR_OAUTH_STATE_SECRET=<LONG_RANDOM_SECRET>
NEXT_PUBLIC_CONNECTOR_CALLBACK_URL=https://memoryostm.live/api/connector/callback

SUPERMEMORY_API_KEY=<SUPERMEMORY_API_KEY>
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_PROJECT=memoryos
