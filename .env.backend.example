NODE_ENV=development
PORT=3001
# Console dev polling: optional override (default 300/min in development, 60 in production)
# MEMORYOS_RATE_LIMIT_MAX=300
# Production distributed rate limiting. Use Upstash Redis REST behind Cloudflare.
# UPSTASH_REDIS_REST_URL=https://replace-with-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
# RATE_LIMIT_REDIS_PREFIX=memoryos:ratelimit

# Cloudflare edge / deploy automation.
# CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Infisical secret management. Do not commit real tokens.
# INFISICAL_PROJECT_ID=replace_with_infisical_project_id
# INFISICAL_TOKEN=replace_with_infisical_machine_identity_token

# --- Local dev without Docker Postgres (recommended for `bun run dev:all`) ---
# Memory + Company Brain persist under ./data. Connector OAuth tokens still need Postgres.
MEMORY_STORE_BACKEND=json
# Optional: sqlite instead of json (single-file DB at ./data/memoryos.db)
# MEMORY_STORE_BACKEND=sqlite
# MEMORY_STORE_DEV_FALLBACK=sqlite

# --- Postgres (connectors OAuth, agent sessions, full parity) ---
# docker compose up -d postgres
# npm run prisma:push   # sync tables (no prisma/migrations; schema-only)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memoryos?schema=public"
# Optional disposable database used by `npm run security:backup:gate:strict`.
# Never point this at production. The restore gate can drop/recreate objects there.
# DATABASE_RESTORE_TEST_URL="postgresql://postgres:postgres@localhost:5432/memoryos_restore?schema=public"
# For local Docker Postgres, let the backup gate use the container's client tools.
# EPOCH_POSTGRES_TOOLS_CONTAINER=memoryos-postgres
# MEMORY_STORE_BACKEND=postgres
# PRISMA_DB_PUSH_ON_START=true
JWT_SECRET=replace_with_64_char_random_secret
MEMORYOS_JWT_SECRET=replace_with_64_char_random_secret

JWT_ISSUER=memoryos
JWT_AUDIENCE=memoryos-api

# Clerk auth. Production must use live Clerk keys and must not enable dev auth bypass.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key

POLAR_CHECKOUT_URL_PRO=https://buy.polar.sh/polar_cl_SOiqHpm4KkbmbGYFPnHOtrSsD5yMfl8jlZYa73NQyny
POLAR_CHECKOUT_URL_SCALE=https://buy.polar.sh/polar_cl_MdEWIcK0NND2c9rbEOWmGKZfw5SfVaW70T27Y2YjTOA
POLAR_CHECKOUT_URL_ENTERPRISE=""
POLAR_WEBHOOK_SECRET=polar_whs_replace_with_polar_webhook_secret
CHECKOUT_PROVIDER=polar

# OpenRouter — Company Brain agents and Flight Recorder (server-side). End users configure Continuity Lab
# in the UI: Continuity Lab → Company Model → paste OpenRouter key → Save (one key for all models).
# Optional hosted-demo default (NOT required for end users; do not document as user setup):
# PLATFORM_OPENROUTER_KEY=sk-or-v1_...
# Legacy alias for local dev bootstrap only:
OPENROUTER_API_KEY=sk-or-v1_replace_with_openrouter_key
# Optional: MEMORYOS_RUNTIME_SEED_LLM_FROM_ENV=false disables silent platform-key seed on runtime start.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://memoryostm.live
OPENROUTER_APP_TITLE="MemoryOS Living Memory Demo"
# Optional override for runtime bootstrap / Company Model default (OpenHands expects openrouter/ prefix)
# MEMORYOS_RUNTIME_LLM_MODEL=openrouter/pareto-code

AGENT_A_MODEL=z-ai/glm-4.5-air:free
AGENT_B_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
SLACK_CLIENT_ID=replace_with_slack_client_id
SLACK_CLIENT_SECRET=replace_with_slack_client_secret
SLACK_SIGNING_SECRET=replace_with_slack_signing_secret
# Sentry API token for Deployment errors live connector.
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
# Optional comma-separated project slugs. Empty means all readable unresolved issues.
SENTRY_PROJECT_SLUGS=memoryos-api,memoryos-frontend
SENTRY_API_BASE_URL=https://sentry.io
SENTRY_SYNC_ISSUE_LIMIT=25
# Devin API service-user connector for Devin agent sessions.
DEVIN_SERVICE_USER_TOKEN=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai
# DEVIN_SYNC_SESSION_LIMIT=25
# DEVIN_REQUEST_TIMEOUT_MS=15000
NOTION_CLIENT_ID=replace_with_notion_client_id
NOTION_CLIENT_SECRET=replace_with_notion_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
MICROSOFT_CLIENT_ID=replace_with_microsoft_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_client_secret
# Atlassian OAuth 3LO (optional — use PAT via POST /api/connector/jira/connect instead)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# JIRA_SYNC_ISSUE_PAGE_LIMIT=50
# JIRA_SYNC_COMMENT_MAX_PER_ISSUE=15
# JIRA_REQUEST_TIMEOUT_MS=15000
# Linear OAuth (Company Sources -> Linear). Use a Linear API app for user-facing OAuth.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# LINEAR_OAUTH_SCOPES=read
# LINEAR_OAUTH_ACTOR=app
# LINEAR_SYNC_ISSUE_LIMIT=50
# LINEAR_SYNC_COMMENT_LIMIT=10
# LINEAR_REQUEST_TIMEOUT_MS=15000

CONNECTOR_OAUTH_STATE_SECRET=replace_with_64_char_random_oauth_state_secret
# NEXT_PUBLIC_CONNECTOR_CALLBACK_URL=https://memoryostm.live/api/connector/callback
NEXT_PUBLIC_CONNECTOR_CALLBACK_URL=http://localhost:3000/api/connector/callback

# In-house semantic retrieval (replaces Supermemory context search when enabled).
# Uses OPENROUTER_API_KEY or OPENAI_API_KEY. Without a key, retrieval stays lexical-only.
MEMORYOS_EMBEDDINGS_ENABLED=true
MEMORYOS_EMBEDDING_MODEL=text-embedding-3-small

# Supermemory: optional external context + connector ingestion when MEMORYOS_EMBEDDINGS_ENABLED is false.
# SUPERMEMORY_API_KEY=sm_...
# SUPERMEMORY_BASE_URL=https://api.supermemory.ai
# SUPERMEMORY_PROJECT=memoryos

# MEMORYOS_API_ORIGIN=https://memoryostm.live
MEMORYOS_API_ORIGIN=http://localhost:3001
# NEXT_PUBLIC_MEMORYOS_API_ORIGIN=https://memoryostm.live
NEXT_PUBLIC_MEMORYOS_API_ORIGIN=same-origin
# Production browser origins allowed to call the backend. Comma-separated.
# MEMORYOS_CORS_ORIGINS=https://app.memoryostm.live,https://memoryostm.live
# Canonical production app URL; used by CORS and OAuth checks when MEMORYOS_CORS_ORIGINS is omitted.
# NEXT_PUBLIC_APP_URL=https://app.memoryostm.live
# Local development example:
# MEMORYOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desktop provider runtime (session Desktop tab)
# sandbox: uses static sandbox URLs (default)
# external: calls an external desktop broker API (VM/VNC/WebRTC service)
MEMORYOSTM_DESKTOP_PROVIDER=sandbox
# Optional sandbox URL templates (supports {threadId})
# MEMORYOS_DESKTOP_SANDBOX_URL_UBUNTU=http://localhost:3000/desktop-sandbox.html?thread={threadId}&os=ubuntu
# MEMORYOS_DESKTOP_SANDBOX_URL_WINDOWS=http://localhost:3000/desktop-sandbox.html?thread={threadId}&os=windows
# External provider base URL + auth (used when MEMORYOSTM_DESKTOP_PROVIDER=external)
# MEMORYOSTM_DESKTOP_PROVIDER_BASE_URL=http://localhost:8090
# MEMORYOSTM_DESKTOP_PROVIDER_TOKEN=
# Built-in bridge route (same backend) for local end-to-end testing:
# MEMORYOSTM_DESKTOP_PROVIDER_BASE_URL=http://localhost:3001/internal/desktop-provider
# Optional preview URL templates used by bridge (supports {threadId})
# MEMORYOSTM_DESKTOP_PROVIDER_PREVIEW_URL_UBUNTU=http://localhost:3000/desktop-sandbox.html?thread={threadId}&os=ubuntu
# MEMORYOSTM_DESKTOP_PROVIDER_PREVIEW_URL_WINDOWS=http://localhost:3000/desktop-sandbox.html?thread={threadId}&os=windows
# Fleet JSON nodes may also define screenshotUrlTemplate for desktop proof capture.

# Canonical MemoryOS memory store: local (Postgres when MEMORY_STORE_BACKEND=postgres). Use mem0 only if MEMORY_STORE_PROVIDER=mem0 + MEM0_API_KEY.
MEMORY_STORE_PROVIDER=local
# MEM0_API_KEY=  # optional legacy vector store; not used when MEMORY_STORE_PROVIDER=local
COMPANY_BRAIN_ALERT_WEBHOOK_URL=
COMPANY_BRAIN_SLACK_WEBHOOK_URL=
COMPANY_BRAIN_ALERT_EMAIL_TO=
METRICS_TOKEN=replace_with_metrics_bearer_token

COMPANY_BRAIN_SCHEDULER_INTERVAL_SECONDS=600
COMPANY_BRAIN_SOURCE_EVENT_MAX_ATTEMPTS=5
COMPANY_BRAIN_SOURCE_EVENT_BACKOFF_BASE_SECONDS=20
COMPANY_BRAIN_WORKER_STALE_SECONDS=180
CONNECTOR_SYNC_MAX_ATTEMPTS=3
CONNECTOR_SYNC_BACKOFF_MS=750
CONNECTOR_SYNC_ATTEMPT_TIMEOUT_MS=30000
# Dev terminal noise controls.
# Production defaults connector auto-sync on. Local dev defaults it off unless explicitly true.
# CONNECTOR_AUTO_SYNC_ENABLED=true
# CONNECTOR_SYNC_VERBOSE_LOGS=false
# COMPANY_BRAIN_ALERT_LOG_INFO=false
# Per-source auto-sync intervals. External API sync is scheduled, not browser-polled every few seconds.
# CONNECTOR_AUTO_SYNC_LINEAR_SECONDS=900
# Local production bridge for exported agent chats and local engineering logs.
# Watches connected local roots for Cursor, VS Code, Codex app, ChatGPT, Windsurf, Devin, CI/CD logs, and deployment-error files.
ENGINEERING_SIGNAL_LIVE_WATCH_ENABLED=true
ENGINEERING_SIGNAL_LIVE_WATCH_INTERVAL_MS=2000
ENGINEERING_SIGNAL_LIVE_WATCH_MAX_FILES=250
# Default staleness window (seconds) for connected connectors without a recent sync
CONNECTOR_FRESHNESS_STALE_SECONDS=3600
COMPANY_BRAIN_SCHEDULER_ENABLED=false
# Operational map compiler: contract (default in development) | legacy (regex fallback)
COMPANY_BRAIN_MAP_COMPILER=contract

# Release trust gates: npm run trust:gate -- --profile=dev|preview|prod (benchmark + company-brain)
COMPANY_BRAIN_QUEUE_BACKEND=file
# When true, low-risk execution proposals auto-approve and run on propose (medium/high always require review).
COMPANY_BRAIN_AUTO_EXECUTE_LOW_RISK=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_SERVICE=memoryos-backend

# Waitlist / pilot email delivery via your own SMTP provider.
# Examples: Gmail SMTP, Google Workspace SMTP relay, SendGrid SMTP, Postmark SMTP, Mailgun SMTP, etc.
WAITLIST_FROM_NAME=Epoch
WAITLIST_FROM_EMAIL=founder@epochtm.me
WAITLIST_REPLY_TO_EMAIL=founder@epochtm.me
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=founder@epochtm.me
SMTP_PASSWORD=replace_with_smtp_password

DD_ENV=development
DD_TRACE_ENABLED=false
DD_PROFILING_ENABLED=false
DD_TRACE_AGENT_URL=http://localhost:8126

# --- Phase 1 production readiness gate ---
# Use after deploying staging/production and after running source gates.
# PHASE1_PRODUCTION_PROFILE=production
# PHASE1_PROD_BASE_URL=https://api.memoryostm.live
# PHASE1_GATE_ORG_ID=org_replace_with_staging_or_prod_org
# PHASE1_GATE_TOKEN=replace_with_memoryos_jwt_or_api_token
EPOCH_OBJECT_STORAGE_ENDPOINT=
EPOCH_OBJECT_STORAGE_BUCKET=
EPOCH_OBJECT_STORAGE_REGION=
EPOCH_OBJECT_STORAGE_ACCESS_KEY_ID=
EPOCH_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# external_kms (default), provider_managed, or local_secret (budget/non-enterprise).
EPOCH_ENCRYPTION_MODE=external_kms
EPOCH_KMS_KEY_REFERENCE=
EPOCH_KMS_SECRET=

# --- Epoch configured AI worker (opt-in; disabled unless explicitly enabled) ---
EPOCH_WORKER_AI_ENABLED=false
EPOCH_WORKER_AI_PROVIDER=openrouter
EPOCH_WORKER_AI_MODEL=openrouter/free
EPOCH_WORKER_AI_MAX_OUTPUT_TOKENS=512
EPOCH_OPENROUTER_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
EPOCH_OPENROUTER_AI_API_KEY=
# Optional OpenRouter attribution headers.
EPOCH_OPENROUTER_HTTP_REFERER=
EPOCH_OPENROUTER_X_TITLE=Epoch
EPOCH_OPENROUTER_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
EPOCH_OPENROUTER_AI_API_KEY=

EPOCH_OBJECT_STORAGE_ACCESS_KEY_ID=
EPOCH_OBJECT_STORAGE_SECRET_ACCESS_KEY=
EPOCH_OBJECT_STORAGE_ENDPOINT=
EPOCH_OBJECT_STORAGE_BUCKET=
EPOCH_OBJECT_STORAGE_REGION=
# Epoch runtime endpoints (optional; keep credentials out of source control)
# Modal must expose an HTTPS OpenAI-compatible endpoint for /health,
# /v1/models, and /v1/chat/completions.
# EPOCH_RUNTIME_MODAL_ENDPOINT=https://<modal-endpoint>/v1/
# The adapter also accepts the endpoint origin without /v1.
# EPOCH_RUNTIME_MODAL_TOKEN=<modal-endpoint-token>
# The Modal app default is MiniMaxAI/SynLogic-7B. Set EPOCH_MODAL_MODEL for another checkpoint.
# To let the mission worker use Modal directly:
# EPOCH_WORKER_AI_ENABLED=true
# EPOCH_WORKER_AI_PROVIDER=modal
# EPOCH_WORKER_AI_MODEL=MiniMaxAI/SynLogic-7B
