# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python caches
__pycache__/
*.pyc
.blackboxcli/
.memoryostm/runtime/
.memoryostm/config.local.json

# local Codex MCP config; keep repo-scoped skills commit-friendly
/.codex/config.toml
!/.codex/
