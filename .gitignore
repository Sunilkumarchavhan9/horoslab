# next.js
/.next/
/memoryos-frontend/.next/
/memoryos-frontend/out/
/out/

# production
/build

# Generated native/package build output and local smoke-test workspaces.
**/target/
/.tmp/
**/.next-corrupt-backup-*/

# misc
.tmp-*
.epoch-github-tmp/
lint_errors.txt
lint_output.txt
.recovery-backup-before-vscode-restore/
.DS_Store
*.pem

# Local Epoch model/artifact caches are not source-controlled.
/.epoch-cache/
/.epoch-runtime-models/
/.epoch-github-tmp/
/.codex-logs/
/.memoryos/
/.memoryostm/
/test-results/
/data
!/data
/data/*
!/data/eval
/data/eval/*
!/data/eval/best-config.json
!/data/eval/baseline-report.json
