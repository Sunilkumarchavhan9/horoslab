{
  "name": "memoryos-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:full": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,green\" --kill-others-on-fail \"npm run dev\" \"bun --cwd memoryos-frontend run dev\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "tsx server/index.ts",
    "start:next": "next start",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "token": "tsx scripts/make-token.ts",
    "mcp:stdio": "tsx packages/mcp-server/src/stdio.ts",
    "mcp:build": "npm run build --prefix packages/mcp-server",
    "mcp:pack": "npm --prefix packages/mcp-server run pack:dry",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:benchmark": "tsx scripts/eval-benchmark.ts",
    "eval:benchmark:gate": "tsx scripts/benchmark-gate.ts",
    "eval:benchmark:gate:dev": "tsx scripts/benchmark-gate.ts --profile=dev",
    "eval:benchmark:gate:preview": "tsx scripts/benchmark-gate.ts --profile=preview",
    "eval:benchmark:gate:prod": "tsx scripts/benchmark-gate.ts --profile=prod",
    "eval:company-brain:gate": "tsx scripts/eval-company-brain-gate.ts",
    "eval:company-brain:scenario-gate": "tsx scripts/check-company-brain-scenarios.ts",
    "ops:check:observability": "tsx scripts/check-observability-env.ts",
    "ops:check:observability:backend": "tsx scripts/check-observability-env.ts",
    "ops:check:observability:frontend": "tsx scripts/check-observability-env-frontend.ts",
    "ops:doppler:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/ops/doppler-bootstrap.ps1",
    "ops:doppler:dev": "doppler run -- npm run dev",
    "ops:doppler:dev:full": "doppler run -- npm run dev:full",
    "ops:doppler:test": "doppler run -- npm run test",
    "smoke:company-brain:prod": "tsx scripts/prod-smoke-company-brain.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "tune:retrieval": "tsx scripts/tune-retrieval.ts",
    "tune:apply": "tsx scripts/write-best-config.ts",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "lint": "eslint",
    "lint:ci": "eslint shared/planCatalog.ts memoryos-frontend/components/landing/pricing-section.tsx memoryos-frontend/components/landing/landing-nav.tsx memoryos-frontend/components/developer-console/sections/connectors-section.tsx memoryos-frontend/app/pricing/page.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.3",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@notionhq/client": "^2.3.0",
    "@octokit/rest": "^21.1.1",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.53.1",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dd-trace": "^5.103.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "mem0ai": "^2.3.0",
    "next": "16.1.6",
    "prom-client": "^15.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "trustedDependencies": [
    "protobufjs",
    "unrs-resolver"
  ]
}
