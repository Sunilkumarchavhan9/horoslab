PORT=3001
NODE_ENV=development

# Mem0 integration (required in production)
MEM0_API_KEY=your_mem0_api_key

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=memoryos
JWT_AUDIENCE=memoryos-api

# Runtime store backend: json | sqlite
MEMORY_STORE_BACKEND=json

# Optional: protect /api/metrics endpoint
METRICS_TOKEN=

