{
  "name": "@epochtm/mcp",
  "version": "0.1.3",
  "description": "Epoch MCP adapter for institutional runtime tools across MCP-compatible runtimes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "epoch-mcp": "dist/stdio.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "memoryos",
    "epoch",
    "mcp",
    "model-context-protocol",
    "agents",
    "ai-agents",
    "memory",
    "continuity",
    "ollama",
    "claude",
    "openai",
    "qwen",
    "deepseek"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
