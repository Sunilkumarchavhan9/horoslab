  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primarySkill     AgentSkill  @relation("PrimarySkillConflicts", fields: [primarySkillId], references: [id], onDelete: Cascade)
  conflictingSkill AgentSkill? @relation("ConflictingSkillConflicts", fields: [conflictingSkillId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, severity], map: "idx_agent_skill_conflicts_workspace_status_severity")
  @@index([primarySkillId], map: "idx_agent_skill_conflicts_primary")
  @@index([conflictingSkillId], map: "idx_agent_skill_conflicts_conflicting")
  @@map("agent_skill_conflicts")
}

model AgentSkillRouterRule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  skillId     String   @map("skill_id")
  name        String
  trigger     Json
  priority    Int      @default(100)
  status      String   @default("active")
  proof       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill     AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, priority], map: "idx_agent_skill_router_workspace_status_priority")
  @@index([skillId], map: "idx_agent_skill_router_skill")
  @@map("agent_skill_router_rules")
}
