generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  IDLE
  RECORDING
  PAUSED
  VERIFYING
  COMPLETED
}

enum VerificationStatus {
  PASSED
  FAILED
  PENDING
}

enum MemoryStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
  PROMOTED
}

model RecentMemory {
  userId    String  @map("user_id")
  orgId     String? @map("org_id")
  memoryId  String  @map("memory_id")
  dataJson  String  @map("data_json")
  updatedAt String  @map("updated_at")

  @@id([userId, memoryId])
  @@index([userId, updatedAt], map: "idx_recent_memories_user_updated")
  @@index([userId, orgId, updatedAt], map: "idx_recent_memories_user_org_updated")
  @@map("recent_memories")
}

model MemoryEmbedding {
  userId        String  @map("user_id")
  orgId         String? @map("org_id")
  memoryId      String  @map("memory_id")
  model         String
  embeddingJson String  @map("embedding_json")
  updatedAt     String  @map("updated_at")

  @@id([userId, memoryId])
  @@index([userId, updatedAt], map: "idx_memory_embeddings_user_updated")
  @@index([userId, orgId, updatedAt], map: "idx_memory_embeddings_user_org_updated")
  @@map("memory_embeddings")
}

model TimelineEvent {
  id           String  @id
  userId       String  @map("user_id")
  memoryId     String  @map("memory_id")
  eventType    String  @map("event_type")
  reason       String
  timestamp    String
  metadataJson String? @map("metadata_json")

  @@index([userId, timestamp], map: "idx_timeline_user_ts")
  @@map("timeline_events")
}

model RevisionEvent {
  id          String @id
  userId      String @map("user_id")
  memoryId    String @map("memory_id")
  version     Int
  changedAt   String @map("changed_at")
  changedBy   String @map("changed_by")
  reason      String
  changesJson String @map("changes_json")

  @@index([memoryId, version], map: "idx_revision_memory_version")
  @@index([userId, changedAt], map: "idx_revision_user_changed")
  @@map("revision_events")
}

model Connector {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  orgId       String?  @map("org_id")
  name        String // e.g., "GitHub", "Notion"
  type        String // e.g., "github", "notion"
  status      String   @default("not_connected") // connected, error, syncing
  configJson  String?  @map("config_json") // encrypted tokens/credentials
  lastSyncAt  String?  @map("last_sync_at")
  recordCount Int      @default(0) @map("record_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, orgId], map: "idx_connectors_user_org")
  @@map("connectors")
}

/// Per-connector sync run history (user + optional org scoped).
model ConnectorSyncLog {
  id            String  @id
  userId        String  @map("user_id")
  orgId         String? @map("org_id")
  connectorType String  @map("connector_type")
  status        String
  startedAt     String  @map("started_at")
  finishedAt    String? @map("finished_at")
  itemsSynced   Int     @default(0) @map("items_synced")
  errorMessage  String? @map("error_message")
  metadataJson  String? @map("metadata_json")

  @@index([userId, startedAt], map: "idx_connector_sync_logs_user_started")
  @@index([userId, orgId, startedAt], map: "idx_connector_sync_logs_user_org_started")
  @@map("connector_sync_logs")
}

model AgentProfile {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  templateId    String   @map("template_id")
  name          String
  runtime       String
  category      String
  status        String   @default("idle") // online, idle, offline
  connectedAt   String   @map("connected_at")
  lastHeartbeat String   @map("last_heartbeat")
  threads24h    Int      @default(0)
  resumeScore   Int      @default(0)
  handoffs24h   Int      @default(0)
  configJson    String?  @map("config_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_profiles")
}

model AgentSession {
  id                 String              @id @default(uuid())
  projectId          String?
  agentId            String
  model              String
  tool               String
  task               String?
  mode               String
  status             SessionStatus       @default(IDLE)
  startedAt          DateTime            @default(now())
  endedAt            DateTime?
  preflightId        String?
  handoffId          String?
  verificationStatus VerificationStatus?
  summary            String?

  events             AgentSessionEvent[]
  proposedMemories   ProposedMemory[]
  verificationResult VerificationResult?

  @@index([agentId, status])
}

model AgentSessionEvent {
  id          String   @id @default(uuid())
  sessionId   String
  type        String
  summary     String
  payloadJson Json?
  timestamp   DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, timestamp])
}

model ProductAgentSession {
  id        String  @id
  userId    String  @map("user_id")
  orgId     String? @map("org_id")
  agentId   String  @map("agent_id")
  projectId String? @map("project_id")
  goal      String?
  goalId    String? @map("goal_id")
  status    String
  model     String?
  createdAt String  @map("created_at")
  updatedAt String  @map("updated_at")

  @@index([userId, orgId, updatedAt])
  @@index([agentId, status])
  @@map("product_agent_sessions")
}

model ConnectorExecutionProposal {
  id            String  @id
  userId        String  @map("user_id")
  connectorType String  @map("connector_type")
  kind          String
  targetId      String  @map("target_id")
  targetLabel   String? @map("target_label")
  body          String
  status        String
  createdAt     String  @map("created_at")
  reviewedAt    String? @map("reviewed_at")
  executedAt    String? @map("executed_at")
  resultUrl     String? @map("result_url")
  externalId    String? @map("external_id")
  error         String?

  @@index([userId, connectorType, createdAt])
  @@index([status])
  @@map("connector_execution_proposals")
}

model GitHubExecutionProposal {
  id              String  @id
  userId          String  @map("user_id")
  kind            String
  owner           String
  repo            String
  issueNumber     Int?    @map("issue_number")
  body            String
  pullTitle       String? @map("pull_title")
  headBranch      String? @map("head_branch")
  baseBranch      String? @map("base_branch")
  filePath        String? @map("file_path")
  status          String
  createdAt       String  @map("created_at")
  reviewedAt      String? @map("reviewed_at")
  executedAt      String? @map("executed_at")
  githubCommentId Int?    @map("github_comment_id")
  githubPrNumber  Int?    @map("github_pr_number")
  githubResultUrl String? @map("github_result_url")
  error           String?

  @@index([userId, createdAt])
  @@index([owner, repo])
  @@index([status])
  @@map("github_execution_proposals")
}

model ProposedMemory {
  id         String       @id @default(uuid())
  sessionId  String
  type       String
  content    String
  confidence Float
  source     String
  status     MemoryStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, status])
}

model VerificationResult {
  id           String             @id @default(uuid())
  sessionId    String             @unique
  status       VerificationStatus
  confidence   Float
  checksJson   Json
  warningsJson Json?
  createdAt    DateTime           @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id])
}

model BillingAccount {
  userId             String           @id @map("user_id")
  plan               String           @default("Free")
  customerId         String?          @unique @map("customer_id")
  subscriptionId     String?          @map("subscription_id")
  subscriptionStatus String           @default("unknown") @map("subscription_status")
  currentPeriodEnd   String?          @map("current_period_end")
  connectorSyncUsed  Int              @default(0) @map("connector_sync_used")
  tokenUsed          Int              @default(0) @map("token_used")
  searchUsed         Int              @default(0) @map("search_used")
  usagePeriodStart   String?          @map("usage_period_start")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  invoices           BillingInvoice[]

  @@index([plan], map: "idx_billing_account_plan")
  @@map("billing_accounts")
}

model BillingInvoice {
  id               String         @id
  userId           String         @map("user_id")
  amountCents      Int            @map("amount_cents")
  currency         String
  status           String
  issuedAt         String         @map("issued_at")
  hostedInvoiceUrl String?        @map("hosted_invoice_url")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  account          BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, issuedAt], map: "idx_billing_invoice_user_issued")
  @@map("billing_invoices")
}

model BillingEvent {
  id        String  @id
  userId    String? @map("user_id")
  provider  String
  type      String
  status    String
  summary   String
  createdAt String  @map("created_at")

  @@index([userId, createdAt], map: "idx_billing_event_user_created")
  @@map("billing_events")
}

model VoiceSession {
  userId          String  @map("user_id")
  sessionId       String  @map("session_id")
  source          String
  status          String
  workspace       String?
  project         String?
  threadId        String? @map("thread_id")
  startedAt       String  @map("started_at")
  updatedAt       String  @map("updated_at")
  lastChunkAt     String? @map("last_chunk_at")
  endedAt         String? @map("ended_at")
  chunkCount      Int     @default(0) @map("chunk_count")
  totalCharacters Int     @default(0) @map("total_characters")
  metadataJson    String? @map("metadata_json")

  @@id([userId, sessionId])
  @@index([userId, updatedAt], map: "idx_voice_sessions_user_updated")
  @@index([userId, status], map: "idx_voice_sessions_user_status")
  @@map("voice_sessions")
}

model SkillsRulesCache {
  orgId        String  @map("org_id")
  repo         String
  repoKey      String  @map("repo_key")
  ref          String
  itemsJson    String  @map("items_json")
  skillCount   Int     @default(0) @map("skill_count")
  ruleCount    Int     @default(0) @map("rule_count")
  discoveredAt String  @map("discovered_at")
  expiresAt    String  @map("expires_at")
  error        String?

  @@id([orgId, repoKey])
  @@index([orgId, expiresAt], map: "idx_skills_rules_cache_org_expires")
  @@map("skills_rules_cache")
}

model WikiDiagramCache {
  cacheKey     String  @id @map("cache_key")
  userId       String  @map("user_id")
  orgId        String? @map("org_id")
  projectId    String  @map("project_id")
  repoFullName String  @map("repo_full_name")
  branch       String
  diagramType  String  @map("diagram_type")
  mermaid      String
  sourcesJson  String  @map("sources_json")
  title        String
  generatedAt  String  @map("generated_at")
  expiresAt    String  @map("expires_at")

  @@index([userId, expiresAt], map: "idx_wiki_diagram_cache_user_expires")
  @@index([orgId, expiresAt], map: "idx_wiki_diagram_cache_org_expires")
  @@map("wiki_diagram_cache")
}

model BenchmarkScenario {
  id          String @id
  name        String
  mode        String
  caseIdsJson String @map("case_ids_json")
  createdAt   String @map("created_at")
  updatedAt   String @map("updated_at")

  @@index([updatedAt], map: "idx_benchmark_scenarios_updated")
  @@map("benchmark_scenarios")
}

model BenchmarkRun {
  runId       String  @id @map("run_id")
  generatedAt String  @map("generated_at")
  completedAt String? @map("completed_at")
  mode        String
  status      String
  dataJson    String  @map("data_json")

  @@index([generatedAt], map: "idx_benchmark_runs_generated")
  @@index([status], map: "idx_benchmark_runs_status")
  @@map("benchmark_runs")
}

model OperationalArtifact {
  id        String @id
  kind      String
  scope     String @default("")
  name      String
  status    String
  dataJson  String @map("data_json")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  @@unique([kind, scope, name], map: "uniq_operational_artifact_kind_scope_name")
  @@index([kind, scope, updatedAt], map: "idx_operational_artifacts_kind_scope_updated")
  @@index([status, updatedAt], map: "idx_operational_artifacts_status_updated")
  @@map("operational_artifacts")
}

model GovernancePolicySetting {
  userId    String @id @map("user_id")
  dataJson  String @map("data_json")
  savedAt   String @map("saved_at")
  updatedAt String @map("updated_at")

  @@index([updatedAt], map: "idx_governance_policy_settings_updated")
  @@map("governance_policy_settings")
}

model ConflictAction {
  id        String @id
  userId    String @map("user_id")
  type      String
  result    String
  createdAt String @map("created_at")
  dataJson  String @map("data_json")

  @@index([userId, createdAt], map: "idx_conflict_actions_user_created")
  @@index([userId, type, createdAt], map: "idx_conflict_actions_user_type_created")
  @@map("conflict_actions")
}

model ConflictQueueItemRecord {
  id        String @id
  userId    String @map("user_id")
  state     String
  severity  String
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  dataJson  String @map("data_json")

  @@index([userId, state, createdAt], map: "idx_conflict_queue_user_state_created")
  @@index([userId, severity, createdAt], map: "idx_conflict_queue_user_severity_created")
  @@map("conflict_queue_items")
}

model GovernanceReviewQueueItem {
  id        String @id
  userId    String @map("user_id")
  state     String
  reason    String
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  dataJson  String @map("data_json")

  @@index([userId, state, createdAt], map: "idx_governance_review_user_state_created")
  @@map("governance_review_queue_items")
}

model PluginUserStateSetting {
  userId    String @id @map("user_id")
  dataJson  String @map("data_json")
  updatedAt String @map("updated_at")

  @@index([updatedAt], map: "idx_plugin_user_state_settings_updated")
  @@map("plugin_user_state_settings")
}

model ContinuityThread {
  id        String  @id
  userId    String  @map("user_id")
  orgId     String? @map("org_id")
  workspace String
  project   String
  status    String
  updatedAt String  @map("updated_at")
  dataJson  String  @map("data_json")

  @@index([userId, updatedAt], map: "idx_continuity_threads_user_updated")
  @@index([userId, status], map: "idx_continuity_threads_user_status")
  @@index([userId, orgId, updatedAt], map: "idx_continuity_threads_user_org_updated")
  @@map("continuity_threads")
}

model ContinuityFileChange {
  id        String  @id
  userId    String  @map("user_id")
  orgId     String? @map("org_id")
  threadId  String  @map("thread_id")
  status    String
  createdAt String  @map("created_at")
  dataJson  String  @map("data_json")

  @@index([userId, threadId, createdAt], map: "idx_continuity_file_changes_user_thread_created")
  @@index([userId, status], map: "idx_continuity_file_changes_user_status")
  @@index([userId, orgId, threadId, createdAt], map: "idx_continuity_file_changes_user_org_thread_created")
  @@map("continuity_file_changes")
}

/// Per-user (and optional org) Company Brain onboarding funnel progress.
model CompanyBrainFunnel {
  userId    String @map("user_id")
  orgId     String @default("") @map("org_id")
  updatedAt String @map("updated_at")
  dataJson  String @map("data_json")

  @@id([userId, orgId])
  @@index([updatedAt], map: "idx_company_brain_funnel_updated")
  @@index([userId, orgId], map: "idx_company_brain_funnel_user_org")
  @@map("company_brain_funnel_states")
}

/// Per-user (and optional org) Company Brain control-plane blob.
model CompanyBrainPlatformState {
  userId    String @map("user_id")
  orgId     String @default("") @map("org_id")
  updatedAt String @map("updated_at")
  dataJson  String @map("data_json")

  @@id([userId, orgId])
  @@index([updatedAt], map: "idx_company_brain_platform_updated")
  @@index([userId, orgId], map: "idx_company_brain_platform_user_org")
  @@map("company_brain_platform_states")
}

/// Generic user/org scoped settings blob. Settings pages read one section at a time.
model ScopedSetting {
  userId    String @map("user_id")
  orgId     String @default("") @map("org_id")
  section   String
  updatedAt String @map("updated_at")
  dataJson  String @map("data_json")

  @@id([userId, orgId, section])
  @@index([userId, section, updatedAt], map: "idx_scoped_settings_user_section_updated")
  @@index([orgId, section, updatedAt], map: "idx_scoped_settings_org_section_updated")
  @@map("scoped_settings")
}

/// Organization-level non-human users for API automation.
model ServiceUser {
  id        String  @id
  userId    String  @map("user_id")
  orgId     String  @default("") @map("org_id")
  name      String
  scope     String
  role      String
  createdAt String  @map("created_at")
  expiresAt String? @map("expires_at")

  @@index([userId, orgId, createdAt], map: "idx_service_users_user_org_created")
  @@index([orgId, createdAt], map: "idx_service_users_org_created")
  @@map("service_users")
}

/// Personal API keys for MemoryOS API access.
model ApiKey {
  id              String  @id
  userId          String  @map("user_id")
  name            String
  keyPrefix       String  @map("key_prefix")
  keyHash         String  @unique @map("key_hash")
  mode            String
  endpointsJson   String  @map("endpoints_json")
  contentTag      String  @map("content_tag")
  creditLimit     Int?    @map("credit_limit")
  resetLimitEvery String? @map("reset_limit_every")
  expires         String
  createdAt       String  @map("created_at")
  lastUsedAt      String? @map("last_used_at")
  status          String
  revokedAt       String? @map("revoked_at")

  @@index([userId, createdAt], map: "idx_api_keys_user_created")
  @@index([keyHash, status], map: "idx_api_keys_hash_status")
  @@map("api_keys")
}

/// Durable async job queue when MEMORY_STORE_BACKEND=postgres (optional; file/redis otherwise).
model CompanyBrainQueueJob {
  id        String @id
  userId    String @map("user_id")
  jobType   String @map("job_type")
  status    String
  createdAt String @map("created_at")
  dataJson  String @map("data_json")

  @@index([userId, status, createdAt], map: "idx_company_brain_queue_user_status_created")
  @@map("company_brain_queue_jobs")
}

/// Company Brain skills export history (user + optional org scoped).
model CompanyBrainExport {
  id          String  @id
  userId      String  @map("user_id")
  orgId       String? @map("org_id")
  workspace   String
  format      String  @default("skills_markdown")
  status      String  @default("completed")
  generatedAt String  @map("generated_at")
  dataJson    String  @map("data_json")

  @@index([userId, generatedAt], map: "idx_company_brain_exports_user_generated")
  @@index([userId, orgId, generatedAt], map: "idx_company_brain_exports_user_org_generated")
  @@map("company_brain_exports")
}

enum ActionMemoryOutcome {
  success
  failed
  rolled_back
}

enum ActionMemorySourceType {
  github_execution
  continuity
  manual
}

enum ApprovalDecision {
  approved
  rejected
}

/// Operational action lineage — durable record of executed actions and outcomes.
model ActionMemory {
  id               String                  @id
  userId           String                  @map("user_id")
  orgId            String?                 @map("org_id")
  projectId        String?                 @map("project_id")
  workspace        String?
  action           String
  reason           String
  approvedBy       String?                 @map("approved_by")
  approvedAt       String?                 @map("approved_at")
  filesChangedJson String                  @default("[]") @map("files_changed_json")
  outcome          ActionMemoryOutcome
  followUpsJson    String                  @default("[]") @map("follow_ups_json")
  sourceType       ActionMemorySourceType? @map("source_type")
  sourceId         String?                 @map("source_id")
  metadataJson     String?                 @map("metadata_json")
  createdAt        String                  @map("created_at")
  updatedAt        String                  @map("updated_at")

  executionOutcomes ExecutionOutcome[]
  approvalTraces    ApprovalTrace[]

  @@index([userId, orgId, createdAt], map: "idx_action_memories_user_org_created")
  @@index([sourceId], map: "idx_action_memories_source_id")
  @@map("action_memories")
}

/// Audit record of execution result tied to an action memory entry.
model ExecutionOutcome {
  id               String  @id
  actionMemoryId   String? @map("action_memory_id")
  userId           String  @map("user_id")
  orgId            String? @map("org_id")
  goal             String?
  planSummary      String? @map("plan_summary")
  resultSummary    String? @map("result_summary")
  status           String
  errorMessage     String? @map("error_message")
  connectorAdapter String? @map("connector_adapter")
  externalRef      String? @map("external_ref")
  createdAt        String  @map("created_at")

  actionMemory ActionMemory? @relation(fields: [actionMemoryId], references: [id], onDelete: SetNull)

  @@index([actionMemoryId], map: "idx_execution_outcomes_action_memory")
  @@index([userId, orgId, createdAt], map: "idx_execution_outcomes_user_org_created")
  @@map("execution_outcomes")
}

/// Approval decision trace for governed execution proposals.
model ApprovalTrace {
  id             String           @id
  actionMemoryId String?          @map("action_memory_id")
  userId         String           @map("user_id")
  orgId          String?          @map("org_id")
  approverId     String           @map("approver_id")
  decision       ApprovalDecision
  reason         String?
  riskTier       String?          @map("risk_tier")
  proposalId     String?          @map("proposal_id")
  createdAt      String           @map("created_at")

  actionMemory ActionMemory? @relation(fields: [actionMemoryId], references: [id], onDelete: SetNull)

  @@index([actionMemoryId], map: "idx_approval_traces_action_memory")
  @@index([proposalId], map: "idx_approval_traces_proposal_id")
  @@index([userId, orgId, createdAt], map: "idx_approval_traces_user_org_created")
  @@map("approval_traces")
}

/// Human feedback on continuity, handoffs, and model context quality.
model ContinuityFeedback {
  id                 String  @id
  userId             String  @map("user_id")
  orgId              String? @map("org_id")
  kind               String
  rating             Int
  useful             Boolean
  requestId          String? @map("request_id")
  project            String?
  agentId            String? @map("agent_id")
  missingContextJson String  @default("[]") @map("missing_context_json")
  wrongContextJson   String  @default("[]") @map("wrong_context_json")
  shouldRememberJson String  @default("[]") @map("should_remember_json")
  note               String?
  createdAt          String  @map("created_at")

  @@index([userId, orgId, createdAt], map: "idx_continuity_feedback_user_org_created")
  @@index([kind, createdAt], map: "idx_continuity_feedback_kind_created")
  @@map("continuity_feedback")
}

/// Durable MemoryIgnition approval gate requests and outcome links.
model MemoryIgnitionApprovalRequest {
  id                          String  @id
  userId                      String  @map("user_id")
  orgId                       String? @map("org_id")
  source                      String
  runtimeEventId              String  @map("runtime_event_id")
  guardMoment                 String  @map("guard_moment")
  action                      String
  status                      String
  riskLevel                   String  @map("risk_level")
  reason                      String
