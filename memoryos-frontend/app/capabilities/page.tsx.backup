"use client";

import React, { useState } from "react";
import Link from "next/link";
import { Search, ChevronDown, ArrowRight, ArrowUpRight, Sun, Monitor, Moon, SearchCode, Database, Zap, ArrowRightCircle } from "lucide-react";
import { LandingNavbar } from "@/components/landing/landing-navbar";
import { FooterCtaSection } from "@/components/landing/footer-cta-section";
import { DhyraLogo } from "@/components/dhyra/primitives/dhyra-logo";
import {
    QwenLogo,
    DeepSeekLogo,
    NvidiaLogo,
    OneXLogo,
    HuggingFaceLogo,
    TeslaLogo,
    GithubLogo
} from "@/components/dhyra/primitives/brand-icons";

import { CAPABILITIES } from "@/lib/capabilities-data";

export default function CapabilitiesPage() {
    const [searchQuery, setSearchQuery] = useState("");
    const [activeFilter, setActiveFilter] = useState("all");
    const [sortOrder, setSortOrder] = useState<"catalog" | "price-asc" | "speed-desc">("catalog");
    const [isDropdownOpen, setIsDropdownOpen] = useState(false);

    const filteredCapabilities = CAPABILITIES.filter(c => {
        const matchesSearch = c.name.toLowerCase().includes(searchQuery.toLowerCase()) || c.id.toLowerCase().includes(searchQuery.toLowerCase());
        if (!matchesSearch) return false;

        if (activeFilter !== "all") {
            return c.tags.some(tag => tag.toLowerCase().includes(activeFilter.toLowerCase()));
        }
        return true; // "all"
    });

    const processedCapabilities = [...filteredCapabilities].sort((a, b) => {
        if (sortOrder === "price-asc") {
            const priceA = parseFloat(a.metrics.input.replace(/[^0-9.]/g, ''));
            const priceB = parseFloat(b.metrics.input.replace(/[^0-9.]/g, ''));
            return priceA - priceB;
        }
        if (sortOrder === "speed-desc") {
            const speedA = parseFloat(a.metrics.speed.toString().replace(/[^0-9.]/g, '')) || 0;
            const speedB = parseFloat(b.metrics.speed.toString().replace(/[^0-9.]/g, '')) || 0;
            return speedB - speedA;
        }
        return 0; // catalog order
    });

    return (
        <div className="relative min-h-screen bg-[#151515] text-[#C8C7BA] font-sans flex flex-col">
            {/* Background Dashed Lines - Global Layout */}
            <div className="fixed inset-0 pointer-events-none z-0">
                <div className="absolute left-[6%] top-0 bottom-0 w-[1px] border-l border-dashed border-[#333]" />
                <div className="absolute left-[14%] top-0 bottom-0 w-[1px] border-l border-dashed border-[#333]" />
                <div className="absolute left-[86%] top-0 bottom-0 w-[1px] border-l border-dashed border-[#333]" />
                <div className="absolute left-[94%] top-0 bottom-0 w-[1px] border-l border-dashed border-[#333]" />
            </div>

            <div className="relative z-10 flex flex-col w-full min-h-screen">
                <div className="w-full border-b border-dashed border-[#333] flex justify-center">
                    <div className="w-full">
                        <LandingNavbar />
                    </div>
                </div>

                <main className="flex-grow flex flex-col items-center w-full relative z-10">
                    <div className="w-[88%] md:w-[72%] mx-auto flex flex-col border-x border-dashed border-[#333]">
                        {/* Header Section */}
                        <div className="w-full px-6 md:px-10 py-20 lg:py-28 flex flex-col items-start border-b border-dashed border-[#333]">
                            <h1 className="text-3xl md:text-5xl lg:text-[56px] leading-[1.1] font-medium tracking-tight text-[#C8C7BA] mb-6">
                                Capabilities <span className="bg-[#75bf00] text-[#151515] px-2 py-0.5 ml-1">Graph</span>
                            </h1>
                            <p className="text-lg md:text-xl lg:text-[22px] text-[#A3A39A] max-w-3xl leading-snug">
                                <span className="text-[#C8C7BA] font-medium">Built for agents that replay context and decode reality.</span> Agent traffic resends the whole conversation or sensor state on every tool call. Here the repeated part hits cache and bills at the cached input rate.
                            </p>
                        </div>

                        {/* Controls Section */}
                        <div className="w-full px-6 md:px-10 py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-dashed border-[#333] bg-[#151515]">
                            <div className="relative flex-grow max-w-xl">
                                <Search size={16} className="absolute left-3 top-1/2 -translate-y-1/2 text-[#75bf00]" />
                                <input
                                    type="text"
                                    placeholder="Search models, IDs, or capabilities"
                                    className="w-full bg-transparent border-none text-xs md:text-[13px] lg:text-[14px] text-[#C8C7BA] placeholder-[#666] focus:outline-none focus:ring-0 pl-10 py-3"
                                    value={searchQuery}
                                    onChange={(e) => setSearchQuery(e.target.value)}
                                />
                            </div>

                            <div className="flex items-center gap-4 text-[9px] md:text-[10px] lg:text-[11px] md:text-[12px] lg:text-[13px] text-[#999]">
                                <div className="relative">
                                    <div
                                        onClick={() => setIsDropdownOpen(!isDropdownOpen)}
                                        className="flex items-center gap-2 border border-dashed border-[#444] px-3 py-1.5 rounded-[4px] cursor-pointer hover:border-[#666] transition-colors"
                                    >
                                        <span className="text-[#C8C7BA]">
                                            {sortOrder === "catalog" ? "Catalog order" : sortOrder === "price-asc" ? "Price: Low to High" : "Speed: High to Low"}
                                        </span>
                                        <ChevronDown size={14} className="text-[#666]" />
                                    </div>

                                    {isDropdownOpen && (
                                        <div className="absolute top-full mt-2 left-0 w-48 bg-[#1a1a1a] border border-[#333] rounded-[4px] shadow-xl z-50 overflow-hidden">
                                            <button
                                                onClick={() => { setSortOrder("catalog"); setIsDropdownOpen(false); }}
                                                className="w-full text-left px-4 py-2 hover:bg-[#2a2a2a] text-[#C8C7BA] transition-colors"
                                            >
                                                Catalog order
                                            </button>
                                            <button
                                                onClick={() => { setSortOrder("price-asc"); setIsDropdownOpen(false); }}
                                                className="w-full text-left px-4 py-2 hover:bg-[#2a2a2a] text-[#C8C7BA] transition-colors"
                                            >
                                                Price: Low to High
                                            </button>
                                            <button
                                                onClick={() => { setSortOrder("speed-desc"); setIsDropdownOpen(false); }}
                                                className="w-full text-left px-4 py-2 hover:bg-[#2a2a2a] text-[#C8C7BA] transition-colors"
                                            >
                                                Speed: High to Low
                                            </button>
                                        </div>
                                    )}
                                </div>
                                <span>{filteredCapabilities.length} capabilities</span>
                                <button
                                    onClick={() => {
                                        setSearchQuery("");
                                        setActiveFilter("all");
                                        setSortOrder("catalog");
                                    }}
                                    className="hover:text-[#C8C7BA] transition-colors"
                                >
                                    Reset
                                </button>
                            </div>
                        </div>

                        {/* Sub-filters */}
                        <div className="w-full px-6 md:px-10 py-4 flex items-center gap-6 text-[9px] md:text-[10px] lg:text-[11px] md:text-[12px] lg:text-[13px] border-b border-dashed border-[#333] bg-[#151515] overflow-x-auto no-scrollbar whitespace-nowrap">
                            <button
                                onClick={() => setActiveFilter("all")}
                                className={`transition-colors font-medium whitespace-nowrap ${activeFilter === "all" ? "text-[#C8C7BA]" : "text-[#999] hover:text-[#C8C7BA]"}`}
                            >
                                Capabilities
                            </button>

                            {[
                                { label: "Tool calling", count: 6 },
                                { label: "JSON mode", count: 6 },
                                { label: "Streaming", count: 6 },
                                { label: "Image input", count: 3 },
                                { label: "Physical Actuation", count: 1 },
                                { label: "Spatial Reasoning", count: 1 },
                                { label: "Proprioception", count: 1 },
                                { label: "Video / 3D Simulation", count: 1 },
                                { label: "World Model", count: 1 },
                            ].map((opt) => {
                                const isActive = activeFilter === opt.label;
                                return (
                                    <button
                                        key={opt.label}
                                        onClick={() => setActiveFilter(opt.label)}
                                        className={`transition-colors flex items-center gap-1.5 whitespace-nowrap ${isActive
                                            ? "bg-[#75bf00] text-[#151515] px-2.5 py-1 font-medium"
                                            : "text-[#999] hover:text-[#C8C7BA]"
                                            }`}
                                    >
                                        {opt.label} <span className={isActive ? "text-[#2a4500] font-medium" : "text-[#555]"}>{opt.count}</span>
                                    </button>
                                );
                            })}
                        </div>

                        {/* List Section */}
                        <div className="w-full flex flex-col pb-32">
                            {processedCapabilities.map((capability, idx) => (
                                <Link href={`/capabilities/${capability.id}`} key={capability.id} className="group flex flex-col lg:flex-row items-start lg:items-center justify-between py-8 px-6 md:px-10 border-b border-dashed border-[#333] hover:bg-[#1a1a1a] transition-colors cursor-pointer relative z-10">

                                    {/* Left: Identity */}
                                    <div className="flex items-start gap-4 flex-1 min-w-[320px]">
                                        <div className="mt-1 w-10 h-10 flex items-center justify-center shrink-0">
                                            <capability.icon size={28} className="text-[#C8C7BA]" />
                                        </div>
                                        <div className="flex flex-col">
                                            <div className="flex items-center gap-3 mb-1">
                                                <h3 className="text-lg md:text-[19px] lg:text-[20px] font-medium text-[#C8C7BA] group-hover:text-[#75bf00] transition-colors">{capability.name}</h3>
                                            </div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] md:text-[12px] lg:text-[13px] text-[#777] mb-2">{capability.id}</div>

                                            <div className="flex items-center gap-2 flex-wrap mt-1">
                                                {capability.tags.map((tag, tIdx) => (
                                                    <React.Fragment key={tIdx}>
                                                        {tag === "Trending" ? (
                                                            <span className="bg-[#2a2a2a] text-[#C8C7BA] text-[9px] md:text-[10px] uppercase font-medium px-1.5 py-0.5 rounded-[2px]">{tag}</span>
                                                        ) : (
                                                            <span className="text-[9px] md:text-[10px] md:text-[11px] lg:text-[12px] text-[#888]">{tag}</span>
                                                        )}
                                                    </React.Fragment>
                                                ))}
                                            </div>
                                        </div>
                                    </div>

                                    {/* Right: Metrics */}
                                    <div className="flex items-start lg:items-center justify-between w-full lg:w-auto mt-6 lg:mt-0 gap-6 lg:gap-10 shrink-0">

                                        {/* Input Tokens */}
                                        <div className="flex flex-col items-start lg:items-end w-20">
                                            <div className="text-[#C8C7BA] font-medium text-base md:text-[17px] lg:text-[18px]"><span className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] font-normal mr-0.5">$</span>{capability.metrics.input.replace('$', '')}</div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] text-left lg:text-right leading-tight mt-1">per 1M input<br />tokens</div>
                                        </div>

                                        {/* Cached Input */}
                                        <div className="flex flex-col items-start lg:items-end w-24">
                                            <div className="text-[#C8C7BA] font-medium text-base md:text-[17px] lg:text-[18px]"><span className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] font-normal mr-0.5">$</span>{capability.metrics.cached.replace('$', '')}</div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] text-left lg:text-right leading-tight mt-1">per 1M cached<br />input tokens</div>
                                        </div>

                                        {/* Output Tokens */}
                                        <div className="flex flex-col items-start lg:items-end w-24">
                                            <div className="text-[#C8C7BA] font-medium text-base md:text-[17px] lg:text-[18px]"><span className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] font-normal mr-0.5">$</span>{capability.metrics.output.replace('$', '')}</div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] text-left lg:text-right leading-tight mt-1">per 1M output<br />tokens</div>
                                        </div>

                                        {/* Cache Hit */}
                                        <div className="flex flex-col items-start lg:items-end w-24 relative">
                                            <div className="text-[#C8C7BA] font-medium text-lg md:text-[19px] lg:text-[20px]">{capability.metrics.cacheHit.replace('%', '')}<span className="text-[9px] md:text-[10px] md:text-[11px] lg:text-[12px] text-[#777] font-normal ml-0.5">%</span></div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] text-left lg:text-right leading-tight mt-1">cache hit, last<br />24 hours</div>

                                            {/* Effective cost note absolutely positioned underneath across Cache Hit and Speed */}
                                            <div className="absolute top-[60px] lg:top-14 right-0 lg:-right-32 text-[9px] md:text-[10px] lg:text-[11px] text-[#666] whitespace-nowrap">
                                                {capability.effectiveCost}
                                            </div>
                                        </div>

                                        {/* Speed */}
                                        <div className="flex flex-col items-start lg:items-end w-32 relative">
                                            <div className="text-[#C8C7BA] font-medium text-lg md:text-[19px] lg:text-[20px]">{capability.metrics.speed}</div>
                                            <div className="text-[9px] md:text-[10px] lg:text-[11px] text-[#777] text-left lg:text-right leading-tight mt-1 whitespace-normal max-w-[100px]">{capability.speedLabel}</div>
                                        </div>

                                        {/* Arrow */}
                                        <div className="hidden lg:flex items-center justify-center w-6 text-[#555] group-hover:text-[#C8C7BA] transition-colors ml-2">
                                            <ArrowRight size={18} />
                                        </div>
                                    </div>

                                </Link>
                            ))}
                        </div>
                    </div>
                </main>

                {/* Footer Section */}
                <FooterCtaSection />
            </div>
        </div>
    );
}
