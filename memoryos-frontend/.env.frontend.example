NODE_ENV=development
PORT=3000
# dev:all ports — 3000 Next, 3011 MemoryOS backend, 3013 OpenHands runtime (no Vite lab on 3002)
# Continuity Lab UI (one-time): cd memoryos-frontend && bun run build:openhands-ui  → external/OpenHands/frontend/build/
# Continuity Lab LLM: set OPENROUTER_API_KEY in repo root `.env` (see .env.backend.example), restart dev:all,
# or save API key under /continuity-lab → Company Model. Next loads root `.env` via next.config.ts.
# OpenHands runtime (Continuity Lab iframe + /assets/* static proxy). Default: http://127.0.0.1:3013
# NEXT_PUBLIC_OPENHANDS_BACKEND_URL=http://127.0.0.1:3013
# OPENHANDS_RUNTIME_ORIGIN=http://127.0.0.1:3013
# Continuity session shell rollout:
# NEXT_PUBLIC_CONTINUITY_SESSION_UI=mythic|classic|rollout
# NEXT_PUBLIC_CONTINUITY_SESSION_UI_ROLLOUT_PERCENT=100
# Clerk auth. Production must use live Clerk keys and must not enable dev auth bypass.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_clerk_publishable_key
# CLERK_SECRET_KEY=sk_live_replace_with_clerk_secret_key

CONNECTOR_OAUTH_STATE_SECRET=replace_with_64_char_random_oauth_state_secret
NEXT_PUBLIC_CONNECTOR_CALLBACK_URL=http://localhost:3000/api/connector/callback
# MemoryOS GitHub App install/configure flow. Set slug to your real GitHub App slug.
NEXT_PUBLIC_GITHUB_APP_SLUG=memoryostm
# Optional: after the MemoryOS GitHub App is installed, point directly to its installation settings.
# NEXT_PUBLIC_GITHUB_APP_INSTALLATION_URL=https://github.com/settings/installations/<memoryos-installation-id>

NEXT_PUBLIC_MEMORYOS_API_ORIGIN=same-origin
MEMORYOS_API_ORIGIN=http://localhost:3011
# Production:
# NEXT_PUBLIC_APP_URL=https://app.memoryostm.live
# NEXT_PUBLIC_MEMORYOS_API_ORIGIN=https://api.memoryostm.live
# NEXT_PUBLIC_CONNECTOR_CALLBACK_URL=https://app.memoryostm.live/api/connector/callback
# Continuity Lab desktop: use the local provider/gateway instead of the fake desktop-sandbox page.
MEMORYOSTM_DESKTOP_PROVIDER=external
MEMORYOSTM_DESKTOP_PROVIDER_BASE_URL=http://localhost:3011/internal/desktop-provider
MEMORYOSTM_DESKTOP_PROVIDER_TOKEN=dev-desktop-token
MEMORYOSTM_DESKTOP_BRIDGE_MODE=fleet
POLAR_CHECKOUT_URL_PRO=https://buy.polar.sh/polar_cl_SOiqHpm4KkbmbGYFPnHOtrSsD5yMfl8jlZYa73NQyny
POLAR_CHECKOUT_URL_SCALE=https://buy.polar.sh/polar_cl_MdEWIcK0NND2c9rbEOWmGKZfw5SfVaW70T27Y2YjTOA
JWT_SECRET=replace_with_64_char_random_secret
MEMORYOS_JWT_SECRET=replace_with_64_char_random_secret
# NEXT_PUBLIC_CLERK_FRONTEND_API=clerk.memoryostm.live
# NEXT_PUBLIC_MEMORYOS_API_BASE_URL=https://api.memoryostm.live
MEMORYOS_JWT_ISSUER=memoryos
MEMORYOS_JWT_AUDIENCE=memoryos-api
JWT_ISSUER=memoryos
JWT_AUDIENCE=memoryos-api
# Do not expose privileged backend tokens through NEXT_PUBLIC_* in production.
# NEXT_PUBLIC_MEMORYOS_CONSOLE_TOKEN=dev_only_replace_if_needed
# NEXT_PUBLIC_MEMORYOS_API_TOKEN=dev_only_replace_if_needed
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
NEXT_PUBLIC_DD_SERVICE=memoryos-frontend
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=100
NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE=0
