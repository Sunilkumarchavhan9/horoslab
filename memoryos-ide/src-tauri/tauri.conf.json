{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoryOS IDE",
  "version": "0.1.0",
  "identifier": "com.memoryos.ide",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000/developer-console/continuity-lab?layout=editor&desktop=1",
    "beforeBuildCommand": "",
    "frontendDist": "../memoryos-frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "MemoryOS IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
