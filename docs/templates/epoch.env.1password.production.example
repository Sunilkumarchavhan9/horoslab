# Production-only template. Never use this file for local development.
# Use with: op run --env-file=docs/templates/epoch.env.1password.production.example -- npm run start
DATABASE_URL=op://Epoch/Production/database-url
EPOCH_OPENROUTER_AI_API_KEY=op://Epoch/Production/openrouter-api-key
EPOCH_OBJECT_STORAGE_ACCESS_KEY_ID=op://Epoch/Production/storage-access-key
EPOCH_OBJECT_STORAGE_SECRET_ACCESS_KEY=op://Epoch/Production/storage-secret-key
EPOCH_OBJECT_STORAGE_ENDPOINT=op://Epoch/Production/storage-endpoint
EPOCH_OBJECT_STORAGE_BUCKET=op://Epoch/Production/storage-bucket
EPOCH_OBJECT_STORAGE_REGION=op://Epoch/Production/storage-region
EPOCH_ENCRYPTION_MODE=local_secret
EPOCH_KMS_SECRET=op://Epoch/Production/epoch-encryption-secret
